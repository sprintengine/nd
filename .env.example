# Copy to .env and adjust. Nothing reads .env automatically yet; export the
# variables in your shell or let your process manager load them.

# Postgres with PostGIS from docker-compose.dev.yml (`pnpm db:up`).
DATABASE_URL=postgres://nd:nd@localhost:54320/nd

# apps/api
# HOST=0.0.0.0
# PORT=3000

# apps/ocpp-gateway (use a different PORT when running both locally)
# HOST=0.0.0.0
# PORT=9000
# Internal ChargerControl endpoint the API calls; loopback by default.
# GATEWAY_INTERNAL_HOST=127.0.0.1
# GATEWAY_INTERNAL_PORT=9100
# Required by the gateway: at least 32 characters (openssl rand -hex 32).
GATEWAY_INTERNAL_SECRET=change-me-to-a-random-32-plus-character-secret
# LOG_LEVEL=info
