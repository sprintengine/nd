{
  "name": "@nd/api",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP and WebSocket API, background jobs and Stripe webhooks.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --conditions=@nd/source --watch src/main.ts",
    "lint": "eslint .",
    "migrate": "node --conditions=@nd/source src/migrate.ts",
    "start": "node dist/main.js",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@fastify/swagger": "catalog:",
    "@nd/config": "workspace:*",
    "@nd/db": "workspace:*",
    "@nd/domain": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "pg": "catalog:",
    "stripe": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "openapi-types": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
