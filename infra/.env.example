# Configuration for infra/compose.yml. Copy to infra/.env (never committed),
# fill in every value marked "required", and keep the file readable by root
# only: `chmod 600 infra/.env`.
#
# Generate secrets with `openssl rand -hex 32`. Hex keeps them safe inside the
# connection URLs compose builds from them.

# --- Hostnames and TLS -------------------------------------------------------

# Required. Base domain. Caddy serves app.<DOMAIN> and api.<DOMAIN> (proxied by
# Cloudflare) and ocpp.<DOMAIN> (DNS-only). See docs/DEPLOY.md.
DOMAIN=example.com

# Required. Contact address for the ACME account that issues the ocpp.<DOMAIN>
# certificate (expiry and policy notices).
ACME_EMAIL=dev@example.com

# --- Images ------------------------------------------------------------------

# Registry and owner the images are pulled from:
# <ND_IMAGE_PREFIX>/nd-api and <ND_IMAGE_PREFIX>/nd-ocpp-gateway.
ND_IMAGE_PREFIX=ghcr.io/sprintengine

# Image tag to run. `main` follows the main branch; pin a commit instead
# (`sha-<40-char commit sha>`) so an upgrade is a deliberate edit of this line.
ND_IMAGE_TAG=main

# --- Postgres ----------------------------------------------------------------

POSTGRES_USER=nd
# Required. Database password, used by Postgres and in DATABASE_URL for the
# api and ocpp-gateway. Use hex (openssl rand -hex 32).
POSTGRES_PASSWORD=
POSTGRES_DB=nd

# --- OCPP gateway ------------------------------------------------------------

# Required. Shared secret on the API's calls to the gateway's internal
# ChargerControl endpoint (port 9100, reachable only on the Compose network).
# At least 32 characters: openssl rand -hex 32.
GATEWAY_INTERNAL_SECRET=

# --- API ---------------------------------------------------------------------

# Required. Signs and encrypts session cookies and auth tokens. At least 32
# characters: openssl rand -hex 32. Changing it signs everyone out.
AUTH_SECRET=

# Optional. Sign in with Apple and Google. Set both values of a provider, or
# neither; empty values count as unset.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Stripe secret API key (sk_live_... in production). Without it,
# becoming a host, saving cards and booking answer 503.
STRIPE_SECRET_KEY=

# Optional. Signing secret (whsec_...) of the Stripe webhook endpoint at
# https://api.<DOMAIN>/webhooks/stripe. Without it the endpoint answers 503, and
# host payout status and card defaults are not kept in step with Stripe.
STRIPE_WEBHOOK_SECRET=

# Bookings are paid upfront as destination charges to the host's account. The
# application fee kept back is the platform fee plus an estimate of the card
# fee, which is passed on to the host. Basis points (100 = 1 %) and cents.
PLATFORM_FEE_BPS=0
CARD_FEE_BPS=150
CARD_FEE_FIXED_CENTS=25

# Bookings one driver may make in an hour.
BOOKING_RATE_LIMIT_PER_HOUR=20

# Years a deleted host's tax details are kept for platform reporting, then purged.
TAX_RECORD_RETENTION_YEARS=6

# Optional. Comma-separated user ids of support staff allowed to use the /admin
# routes (refunding a booking by hand). Empty means nobody.
ADMIN_USER_IDS=

# Durations, at their production values. Test stacks shorten them; keep these.
# A remote start with no StartTransaction after this many seconds has failed.
SESSION_START_TIMEOUT_SECONDS=120
# Minutes after its slot that a session with no StopTransaction is closed.
STALE_SESSION_GRACE_MINUTES=10
# Shortest booking a driver may make, in minutes.
MIN_BOOKING_MINUTES=30
# How long before the slot a driver may arrive and plug in; charging starts at the slot.
ARRIVAL_LEAD_MINUTES=240

# Optional. Log level of the api: fatal, error, warn, info, debug or trace.
API_LOG_LEVEL=info

# --- Email and SMS ------------------------------------------------------------
# The api refuses to start in production without real providers: sign-in
# links go by email and phone verification codes by SMS. Errors in the log
# never show a full address or number.

# Required. smtp or resend.
EMAIL_PROVIDER=smtp
# Required with smtp or resend. Sender of every email; its domain must pass
# SPF/DKIM with the provider.
EMAIL_FROM="nd <no-reply@example.com>"
# With EMAIL_PROVIDER=smtp. Port 465 means TLS from the start (SMTP_SECURE
# defaults to true there); other ports must offer STARTTLS. SMTP_USER and
# SMTP_PASSWORD: both or neither.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# With EMAIL_PROVIDER=resend. Turn the domain's open and click tracking off
# in Resend: the emails carry no tracking of their own.
RESEND_API_KEY=

# Required. twilio.
SMS_PROVIDER=twilio
# With SMS_PROVIDER=twilio: the account SID (AC...) and auth token, and either
# a sender number (E.164) or a Messaging Service SID (MG...), not both.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Optional. true lets the api start with EMAIL_PROVIDER or SMS_PROVIDER set
# to console, which sends nothing (it logs only that a message was dropped).
# For test stacks only: nobody can sign in.
ALLOW_CONSOLE_MESSAGES=false

# --- Push notifications ------------------------------------------------------

# At least one provider is required, unless ALLOW_CONSOLE_PUSH=true.
# iOS and Android: a Firebase service account key with Cloud Messaging rights,
# its JSON on one line (jq -c . key.json). iOS pushes go through FCM to APNs,
# so upload the APNs key in the Firebase console.
FCM_SERVICE_ACCOUNT_JSON=
# Web push: VAPID keys from `npx web-push generate-vapid-keys` and a contact
# (mailto: or https URL). The web app subscribes with the public key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional. true lets the api start with no push provider; pushes are then
# dropped (it logs only that one was). For test stacks only.
ALLOW_CONSOLE_PUSH=false

# --- Tax details -------------------------------------------------------------

# Required. Keys that encrypt hosts' tax numbers and dates of birth
# (AES-256-GCM): comma-separated <id>:<base64 of 32 random bytes>, the first
# one current. Make one with: echo "k$(date +%Y%m):$(openssl rand -base64 32)"
# Losing every key loses the stored tax numbers. Rotation: docs/RUNBOOK.md.
TAX_ENCRYPTION_KEYS=

# --- Backups (infra/backup.sh, infra/restore.sh) -----------------------------
# Any S3-compatible object store. For Cloudflare R2: endpoint
# https://<account id>.r2.cloudflarestorage.com, region `auto`, and an R2 API
# token with Object Read & Write on the bucket only.

BACKUP_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=nd-backups
# Key prefix inside the bucket; end it with a slash, or leave empty.
BACKUP_S3_PREFIX=postgres/
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Dumps older than this are deleted after each successful backup.
BACKUP_RETENTION_DAYS=30
