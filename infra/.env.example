# Configuration for infra/compose.yml. Copy to infra/.env (never committed),
# fill in every value marked "required", and keep the file readable by root
# only: `chmod 600 infra/.env`.
#
# Generate secrets with `openssl rand -hex 32`. Hex keeps them safe inside the
# connection URLs compose builds from them.

# --- Hostnames and TLS -------------------------------------------------------

# Required. Base domain. Caddy serves app.<DOMAIN> and api.<DOMAIN> (proxied by
# Cloudflare) and ocpp.<DOMAIN> (DNS-only). See docs/DEPLOY.md.
DOMAIN=example.com

# Required. Contact address for the ACME account that issues the ocpp.<DOMAIN>
# certificate (expiry and policy notices).
ACME_EMAIL=dev@example.com

# --- Images ------------------------------------------------------------------

# Registry and owner the images are pulled from:
# <ND_IMAGE_PREFIX>/nd-api and <ND_IMAGE_PREFIX>/nd-ocpp-gateway.
ND_IMAGE_PREFIX=ghcr.io/sprintengine

# Image tag to run. `main` follows the main branch; pin a commit instead
# (`sha-<40-char commit sha>`) so an upgrade is a deliberate edit of this line.
ND_IMAGE_TAG=main

# --- Postgres ----------------------------------------------------------------

POSTGRES_USER=nd
# Required. Database password, used by Postgres and in DATABASE_URL for the
# api and ocpp-gateway. Use hex (openssl rand -hex 32).
POSTGRES_PASSWORD=
POSTGRES_DB=nd

# --- OCPP gateway ------------------------------------------------------------

# Required. Shared secret on the API's calls to the gateway's internal
# ChargerControl endpoint (port 9100, reachable only on the Compose network).
# At least 32 characters: openssl rand -hex 32.
GATEWAY_INTERNAL_SECRET=

# --- API ---------------------------------------------------------------------

# Required. Signs and encrypts session cookies and auth tokens. At least 32
# characters: openssl rand -hex 32. Changing it signs everyone out.
AUTH_SECRET=

# Optional. Sign in with Apple and Google. Set both values of a provider, or
# neither; empty values count as unset.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Stripe secret API key (sk_live_... in production). Without it,
# becoming a host, saving cards and booking answer 503.
STRIPE_SECRET_KEY=

# Optional. Signing secret (whsec_...) of the Stripe webhook endpoint at
# https://api.<DOMAIN>/webhooks/stripe. Without it the endpoint answers 503, and
# host payout status and card defaults are not kept in step with Stripe.
STRIPE_WEBHOOK_SECRET=

# Platform fee kept back from each host transfer, in basis points (100 = 1 %).
PLATFORM_FEE_BPS=0

# Optional. Log level of the api: fatal, error, warn, info, debug or trace.
API_LOG_LEVEL=info

# Email and SMS providers are not wired up yet: until they are, the api writes
# only "not sent" to its log in production, never a sign-in link or code.

# --- Backups (infra/backup.sh, infra/restore.sh) -----------------------------
# Any S3-compatible object store. For Cloudflare R2: endpoint
# https://<account id>.r2.cloudflarestorage.com, region `auto`, and an R2 API
# token with Object Read & Write on the bucket only.

BACKUP_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=nd-backups
# Key prefix inside the bucket; end it with a slash, or leave empty.
BACKUP_S3_PREFIX=postgres/
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Dumps older than this are deleted after each successful backup.
BACKUP_RETENTION_DAYS=30
