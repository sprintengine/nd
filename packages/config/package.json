{
  "name": "@nd/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and Vitest presets, and typed environment parsing.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@nd/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tsconfig/*.json": "./tsconfig/*.json",
    "./vitest": "./vitest.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
