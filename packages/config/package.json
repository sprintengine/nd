{
  "name": "@nd/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and Vitest presets, and typed environment parsing.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@nd/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": "./eslint.js",
    "./tsconfig/*.json": "./tsconfig/*.json",
    "./vitest": "./vitest.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "typecheck": "tsc"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:lint",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
